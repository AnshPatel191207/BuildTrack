# ── BuildTrack API ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/buildtrack
# Atlas:   mongodb+srv://<user>:<password>@<cluster>/buildtrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/buildtrack

# JWT secrets — use long random strings (openssl rand -hex 32)
JWT_SECRET=replace_with_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_long_random_secret_32chars
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES_DAYS=30

# Allowed CORS origin for the web/mobile clients (comma separated or *)
CLIENT_URL=*

# Cloudinary (optional). If not configured, photos are stored on local disk
# under server/uploads and served from /uploads — good enough for development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30
